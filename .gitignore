# ==============================================================================
# VMS Frontend - .gitignore (Production Flutter Web)
# ==============================================================================

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# IntelliJ IDEA
*.iml
*.ipr
*.iws
.idea/

# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Flutter / Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/

# Web Ephemerals
lib/generated_plugin_registrant.dart

# Symbol and debug files
*.js.map
*.js.deps

# Environment and Secrets (CRITICAL OPSEC - Never commit secrets)
.env
.env.*
!.env.example

